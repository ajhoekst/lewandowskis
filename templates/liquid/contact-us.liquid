<section class="relative isolate overflow-hidden bg-market-ink py-26 text-center text-market-cream before:absolute before:inset-0 before:-z-10 before:bg-black/55 sm:py-36">
    <img class="absolute inset-0 -z-20 h-full w-full object-cover" src="/assets/img/about_back_2.jpg" alt="">
    <div class="mx-auto w-full max-w-7xl px-5 sm:px-8 relative">
        <h1 class="mx-auto max-w-4xl font-display text-5xl uppercase leading-[0.92] tracking-wide sm:text-7xl lg:text-8xl">Contact Us</h1>
        <p class="mt-4 font-script text-4xl text-market-cream sm:text-5xl">Come see us on the West Side.</p>
    </div>
</section>
<section class="relative bg-market-cream py-16 before:absolute before:inset-0 before:bg-[url('/assets/img/about_back_2.jpg')] before:bg-cover before:bg-center before:opacity-35 [&>*]:relative sm:py-22">
    <div class="mx-auto w-full max-w-7xl px-5 sm:px-8 grid gap-14 lg:grid-cols-[0.75fr_1.25fr]">
        <aside class="text-center">
            <h2 class="font-display text-4xl uppercase leading-none text-market-red sm:text-6xl text-4xl sm:!text-4xl">Location</h2>
            <p class="mt-4 text-lg leading-8">
                1107 Walker Ave NW
                <br>
                Grand Rapids, MI 49504
                <br>
                <a href="tel:+16164542281">(616)-454-2281</a>
            </p>
            <h2 class="mt-10 font-display text-4xl uppercase leading-none text-market-red sm:text-6xl text-4xl sm:!text-4xl">Hours</h2>
            <p class="mt-4 text-lg leading-8">
                Monday–Friday: 9 AM–5:30 PM
                <br>
                Saturday: 9 AM–5:30 PM
                <br>
                Sunday: Closed
            </p>
        </aside>
        <section class="mx-auto max-w-2xl bg-white px-7 py-10 shadow-[0_0_0_10px_#fffdd0,0_0_0_12px_#a80005] sm:px-10">
            <h2 class="font-display text-4xl uppercase leading-none text-market-red sm:text-6xl text-center text-4xl sm:!text-4xl">Send us a message</h2>
            <div id="form-feedback" class="mt-6" aria-live="polite"></div>
            <form class="mt-7 space-y-5"
                  method="post"
                  action="/forms/contact"
                  hx-post="/forms/contact"
                  hx-target="#form-feedback"
                  hx-swap="innerHTML">
                {% if product %}<p class="mb-5 text-center leading-7">You are asking about availability for <strong>{{ product }}</strong>.</p><input type="hidden" name="product_interest" value="{{ product }}">{% endif %}
                <div class="grid gap-5 sm:grid-cols-2">
                    {% for field in fields %}
                        <label class="block font-display text-xl uppercase tracking-wide text-market-red">
                            {{ field.label }}
                            {% if field.name == "message" %}
                                <textarea class="mt-2 w-full border border-market-red/40 bg-market-cream/30 px-3 py-2 font-body text-base outline-none focus:border-market-red focus:ring-1 focus:ring-market-red min-h-36" name="message" required></textarea>
                            {% else %}
                                <input class="mt-2 w-full border border-market-red/40 bg-market-cream/30 px-3 py-2 font-body text-base outline-none focus:border-market-red focus:ring-1 focus:ring-market-red"
                                       name="{{ field.name }}"
                                       autocomplete="{{ field.autocomplete }}"
                                       {% if field.type %}type="{{ field.type }}"{% endif %}
                                       required>
                            {% endif %}
                        </label>
                    {% endfor %}
                </div>
                <div class="text-center">
                    <button class="inline-block rounded-[5px] border-2 border-market-red bg-market-red px-8 py-2 font-display text-lg uppercase tracking-wide text-market-cream no-underline transition hover:border-market-cream hover:bg-market-ink" type="submit">Submit</button>
                </div>
            </form>
        </section>
    </div>
</section>
