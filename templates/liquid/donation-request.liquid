<section class="page-hero">
    <img src="/assets/img/donation_request_back.jpg" alt="">
    <div class="shell relative">
        <h1 class="hero-title mx-auto">Donation Request</h1>
        <p class="hero-script">Helping our community come together.</p>
    </div>
</section>
<section class="paper-section">
    <div class="shell">
        <div class="mx-auto max-w-4xl text-center">
            <p class="text-lg leading-8">
                Lewandoski's Market is fortunate to support nonprofit and community-related causes in our area. Submit requests at least four weeks before your event. Due to high demand, we cannot fulfill every request.
            </p>
        </div>
        <div class="mx-auto mt-12 grid max-w-5xl gap-8 md:grid-cols-2">
            <lqip-image><img class="lqip__placeholder" src="/assets/img/donation_request_1-32.webp" alt="" aria-hidden="true"><picture><source type="image/avif" srcset="/assets/img/donation_request_1-480.avif 480w, /assets/img/donation_request_1-768.avif 768w, /assets/img/donation_request_1-1024.avif 1024w, /assets/img/donation_request_1-1200.avif 1200w"><source type="image/webp" srcset="/assets/img/donation_request_1-480.webp 480w, /assets/img/donation_request_1-768.webp 768w, /assets/img/donation_request_1-1024.webp 1024w, /assets/img/donation_request_1-1200.webp 1200w"><img class="lqip__image h-full w-full object-cover" src="/assets/img/donation_request_1.jpg" sizes="(min-width: 768px) 50vw, 100vw" alt="Market food" loading="lazy" decoding="async"></picture></lqip-image>
            <lqip-image><img class="lqip__placeholder" src="/assets/img/donation_request_2-32.webp" alt="" aria-hidden="true"><picture><source type="image/avif" srcset="/assets/img/donation_request_2-480.avif 480w, /assets/img/donation_request_2-768.avif 768w, /assets/img/donation_request_2-1024.avif 1024w, /assets/img/donation_request_2-1200.avif 1200w"><source type="image/webp" srcset="/assets/img/donation_request_2-480.webp 480w, /assets/img/donation_request_2-768.webp 768w, /assets/img/donation_request_2-1024.webp 1024w, /assets/img/donation_request_2-1200.webp 1200w"><img class="lqip__image h-full w-full object-cover" src="/assets/img/donation_request_2.jpg" sizes="(min-width: 768px) 50vw, 100vw" alt="Lewandoski's Market" loading="lazy" decoding="async"></picture></lqip-image>
        </div>
        <section class="form-panel mx-auto mt-16 max-w-5xl">
            <h2 class="section-title text-center text-4xl">Request Form</h2>
            <div id="form-feedback" class="mt-6" aria-live="polite"></div>
            <form class="mt-7 space-y-5"
                  method="post"
                  action="/forms/donation"
                  hx-post="/forms/donation"
                  hx-target="#form-feedback"
                  hx-swap="innerHTML">
                <h3 class="font-display text-2xl uppercase text-market-red">Requester Contact Information</h3>
                <div class="grid gap-5 sm:grid-cols-2">
                    {% for field in fields %}
                        <label class="form-label">
                            {{ field.label }}
                            {% if field.name == "items_requested" %}
                                <textarea class="field min-h-28" name="{{ field.name }}" required></textarea>
                            {% else %}
                                <input class="field"
                                       name="{{ field.name }}"
                                       {% if field.type %}type="{{ field.type }}"{% endif %}
                                       {% if field.name == "guest_count" %}min="1"{% endif %}
                                       required>
                            {% endif %}
                        </label>
                    {% endfor %}
                </div>
                <div class="text-center">
                    <button class="button" type="submit">Submit Request</button>
                </div>
            </form>
        </section>
    </div>
</section>
