<section class="relative isolate overflow-hidden bg-market-ink py-26 text-center text-market-cream before:absolute before:inset-0 before:-z-10 before:bg-black/55 sm:py-36">
    <img class="absolute inset-0 -z-20 h-full w-full object-cover" src="/assets/img/donation_request_back.jpg" alt="">
    <div class="mx-auto w-full max-w-7xl px-5 sm:px-8 relative">
        <h1 class="mx-auto max-w-4xl font-display text-5xl uppercase leading-[0.92] tracking-wide sm:text-7xl lg:text-8xl">Donation Request</h1>
        <p class="mt-4 font-script text-4xl text-market-cream sm:text-5xl">Helping our community come together.</p>
    </div>
</section>
<section class="relative bg-market-cream py-16 before:absolute before:inset-0 before:bg-[url('/assets/img/about_back_2.jpg')] before:bg-cover before:bg-center before:opacity-35 [&>*]:relative sm:py-22">
    <div class="mx-auto w-full max-w-7xl px-5 sm:px-8">
        <div class="mx-auto max-w-4xl text-center">
            <p class="text-lg leading-8">
                Lewandoski's Market is fortunate to support nonprofit and community-related causes in our area. Submit requests at least four weeks before your event. Due to high demand, we cannot fulfill every request.
            </p>
        </div>
        <div class="mx-auto mt-12 grid max-w-5xl gap-8 md:grid-cols-2">
            <lqip-image class="relative block overflow-hidden bg-market-ink aspect-[3/2]">
            <img class="lqip__placeholder absolute inset-[-12px] h-[calc(100%+24px)] w-[calc(100%+24px)] object-cover blur-[14px] scale-105"
                 src="/assets/img/donation_request_1-32.webp"
                 alt=""
                 aria-hidden="true"
                 role="presentation">
            <picture class="h-full w-full">
                <source type="image/avif"
                        srcset="/assets/img/donation_request_1-480.avif 480w,
                                /assets/img/donation_request_1-768.avif 768w,
                                /assets/img/donation_request_1-1024.avif 1024w,
                                /assets/img/donation_request_1-1200.avif 1200w">
                <source type="image/webp"
                        srcset="/assets/img/donation_request_1-480.webp 480w,
                                /assets/img/donation_request_1-768.webp 768w,
                                /assets/img/donation_request_1-1024.webp 1024w,
                                /assets/img/donation_request_1-1200.webp 1200w">
                <img class="lqip__image relative opacity-0 transition-opacity duration-300 h-full w-full object-cover"
                     src="/assets/img/donation_request_1.jpg"
                     sizes="(min-width: 768px) 50vw,
                            100vw"
                     alt="Market food"
                     loading="lazy"
                     decoding="async">
            </picture>
            </lqip-image>
            <lqip-image class="relative block overflow-hidden bg-market-ink aspect-[3/2]">
            <img class="lqip__placeholder absolute inset-[-12px] h-[calc(100%+24px)] w-[calc(100%+24px)] object-cover blur-[14px] scale-105"
                 src="/assets/img/donation_request_2-32.webp"
                 alt=""
                 aria-hidden="true"
                 role="presentation">
            <picture class="h-full w-full">
                <source type="image/avif"
                        srcset="/assets/img/donation_request_2-480.avif 480w,
                                /assets/img/donation_request_2-768.avif 768w,
                                /assets/img/donation_request_2-1024.avif 1024w,
                                /assets/img/donation_request_2-1200.avif 1200w">
                <source type="image/webp"
                        srcset="/assets/img/donation_request_2-480.webp 480w,
                                /assets/img/donation_request_2-768.webp 768w,
                                /assets/img/donation_request_2-1024.webp 1024w,
                                /assets/img/donation_request_2-1200.webp 1200w">
                <img class="lqip__image relative opacity-0 transition-opacity duration-300 h-full w-full object-cover"
                     src="/assets/img/donation_request_2.jpg"
                     sizes="(min-width: 768px) 50vw,
                            100vw"
                     alt="Lewandoski's Market"
                     loading="lazy"
                     decoding="async">
            </picture>
            </lqip-image>
        </div>
        <section class="mx-auto mt-16 max-w-5xl bg-white px-7 py-10 shadow-[0_0_0_10px_#fffdd0,0_0_0_12px_#a80005] sm:px-10">
            <h2 class="font-display text-4xl uppercase leading-none text-market-red sm:text-6xl sm:!text-4xl text-center">Request Form</h2>
            <div id="form-feedback" class="mt-6" aria-live="polite"></div>
            <form class="mt-7 space-y-5"
                  method="post"
                  action="/forms/donation"
                  hx-post="/forms/donation"
                  hx-target="#form-feedback"
                  hx-swap="innerHTML">
                <h3 class="font-display text-2xl uppercase text-market-red">Requester Contact Information</h3>
                <div class="grid gap-5 sm:grid-cols-2">
                    {% for field in fields %}
                        <label class="block font-display text-xl uppercase tracking-wide text-market-red">
                            {{ field.label }}
                            {% if field.name == "items_requested" %}
                                <textarea class="mt-2 w-full border border-market-red/40 bg-market-cream/30 px-3 py-2 font-body text-base outline-none focus:border-market-red focus:ring-1 focus:ring-market-red min-h-28" name="{{ field.name }}" required></textarea>
                            {% else %}
                                <input class="mt-2 w-full border border-market-red/40 bg-market-cream/30 px-3 py-2 font-body text-base outline-none focus:border-market-red focus:ring-1 focus:ring-market-red"
                                       name="{{ field.name }}"
                                       autocomplete="{{ field.autocomplete }}"
                                       {% if field.type %}type="{{ field.type }}"{% endif %}
                                       {% if field.name == "guest_count" %}min="1"{% endif %}
                                       required>
                            {% endif %}
                        </label>
                    {% endfor %}
                </div>
                <div class="text-center">
                    <button class="inline-block rounded-[5px] border-2 border-market-red bg-market-red px-8 py-2 font-display text-lg uppercase tracking-wide text-market-cream no-underline transition hover:border-market-cream hover:bg-market-ink" type="submit">Submit Request</button>
                </div>
            </form>
        </section>
    </div>
</section>
