    <section class="community-carousel"
             aria-label="Community highlights"
             data-community-carousel>
        <div class="community-carousel__slide is-active">
            <img src="/assets/img/gallery/57566a9c4f5c40f6bfee99fdf56abb45.jpeg"
                 alt="Sausages with vegetables">
            <div class="community-carousel__content">
                <h2>Proudly Serving Our Community</h2>
                <a href="/donation-request">Donation Request</a>
            </div>
        </div>
        <div class="community-carousel__slide" aria-hidden="true">
            <img src="/assets/img/gallery/57566a9c4f5c40f6bfee99fdf56abb45.jpeg"
                 alt="Sausages with vegetables">
        </div>
        <button class="community-carousel__pause"
                type="button"
                data-community-carousel-pause
                aria-label="Pause carousel">Ⅱ</button>
        <div class="community-carousel__dots" aria-hidden="true">
            <span class="is-active"></span><span></span>
        </div>
    </section>
    <section class="paper-section">
        <div class="shell max-w-4xl">
            <h2 class="section-title text-center">Frequently Asked Questions</h2>
            <div class="mt-10">
                <details class="market-details">
                    <summary>Do you make fresh kielbasa and sausage?</summary>
                    <p class="mt-4 leading-7">
                        Yes. Lewandoski's Market offers fresh and smoked kielbasa, Krakowska, and a selection of house-made sausage. Visit the market to see today's selection.
                    </p>
                </details>
                <details class="market-details">
                    <summary>Where is Lewandoski's Market located?</summary>
                    <p class="mt-4 leading-7">You can find us at 1107 Walker Ave NW in Grand Rapids, Michigan, on the West Side.</p>
                </details>
                <details class="market-details">
                    <summary>What are your market hours?</summary>
                    <p class="mt-4 leading-7">We are open Monday through Saturday from 9 AM to 5:30 PM. We are closed on Sundays.</p>
                </details>
                <details class="market-details">
                    <summary>Do you carry Polish grocery products?</summary>
                    <p class="mt-4 leading-7">
                        Yes. Our market carries Polish grocery staples, pierogi, specialty ingredients, and familiar pantry favorites.
                    </p>
                </details>
                <details class="market-details">
                    <summary>How do donation requests work?</summary>
                    <p class="mt-4 leading-7">
                        We support nonprofit and community-related causes when possible. Submit donation requests at least four weeks before your event through our donation request form.
                    </p>
                </details>
            </div>
        </div>
    </section>
    <section class="paper-section">
        <div class="shell max-w-5xl text-center">
            <h2 class="section-title">Explore the Market</h2>
            <p class="mx-auto mt-5 max-w-3xl text-lg leading-8">
                Discover Polish grocery staples, fresh cuts, homemade favorites, and market gifts at Lewandoski's Market.
            </p>
            <nav class="mt-8 flex flex-wrap justify-center gap-3"
                 aria-label="Product categories">
                <a class="button" href="/products/sausage">Fresh Kielbasa &amp; Sausage</a><a class="button" href="/products/meats">Fresh Meats</a><a class="button" href="/products/homemade-foods">Homemade Foods</a><a class="button" href="/products/polish-grocery">Polish Grocery</a><a class="button" href="/products/gift-cards-and-gifts">Gifts &amp; Gift Cards</a><a class="button" href="/products/breads-and-desserts">Breads &amp; Desserts</a>
            </nav>
        </div>
    </section>
    <section class="paper-section">
        <div class="shell max-w-none px-0">
            <div class="gallery-grid">
                {% for item in gallery %}
                    <a class="gallery-item group{% if item.wide %} gallery-item--wide{% endif %}"
                       href="{{ item.image }}"
                       aria-label="{{ item.title }}">
                        {% assign base = item.image | remove: ".jpeg" %}
                        <lqip-image>
                        <img class="lqip__placeholder"
                             src="{{ base }}-32.webp"
                             alt=""
                             aria-hidden="true"
                             role="presentation">
                        <picture>
                            {% if item.maxWidth == 480 %}
                                <source type="image/avif"
                                        srcset="{{ base }}-320.avif 320w,
                                                {{ base }}-480.avif 480w">
                                <source type="image/webp"
                                        srcset="{{ base }}-320.webp 320w,
                                                {{ base }}-480.webp 480w">
                                <img class="lqip__image"
                                     src="{{ item.image }}"
                                     srcset="{{ base }}-320.webp 320w,
                                             {{ base }}-480.webp 480w"
                                     sizes="(min-width: 768px) 20vw,
                                            50vw"
                                     alt="{{ item.title }}"
                                     loading="lazy"
                                     decoding="async">
                            {% else %}
                                <source type="image/avif"
                                        srcset="{{ base }}-320.avif 320w,
                                                {{ base }}-480.avif 480w,
                                                {{ base }}-640.avif 640w,
                                                {{ base }}-768.avif 768w,
                                                {{ base }}-1024.avif 1024w">
                                <source type="image/webp"
                                        srcset="{{ base }}-320.webp 320w,
                                                {{ base }}-480.webp 480w,
                                                {{ base }}-640.webp 640w,
                                                {{ base }}-768.webp 768w,
                                                {{ base }}-1024.webp 1024w">
                                <img class="lqip__image"
                                     src="{{ item.image }}"
                                     srcset="{{ base }}-320.webp 320w,
                                             {{ base }}-480.webp 480w,
                                             {{ base }}-640.webp 640w,
                                             {{ base }}-768.webp 768w,
                                             {{ base }}-1024.webp 1024w"
                                     sizes="(min-width: 768px) {% if item.wide %}40vw{% else %}20vw{% endif %}, {% if item.wide %}100vw{% else %}50vw{% endif %}"
                                     alt="{{ item.title }}"
                                     loading="lazy"
                                     decoding="async">
                            {% endif %}
                        </picture>
                        </lqip-image>
                        <span aria-hidden="true">{{ item.title }}</span></a>
                {% endfor %}
            </div>
        </div>
    </section>
    <section class="reviews-section"
             aria-labelledby="reviews-title"
             data-reviews-carousel>
        <div class="reviews-shell">
            <h2 id="reviews-title">Reviews</h2>
            <div class="reviews-track">
                <article class="review-slide is-active">
                    <p class="review-source">Review by - Yelp</p>
                    <p class="review-author">
                        Sean D: <span aria-label="5 out of 5 stars">★★★★★</span>
                    </p>
                    <blockquote>
                        Where do I even begin?! This place is full of charm and the best darn meat you find anywhere. Kielbasa (both, smoked and fresh) is top notch...
                    </blockquote>
                </article>
                <article class="review-slide" aria-hidden="true">
                    <p class="review-source">Review by - Yelp</p>
                    <p class="review-author">
                        Linda R: <span aria-label="5 out of 5 stars">★★★★★</span>
                    </p>
                    <blockquote>
                        Just tried the new owner's kielbasa. It was really good. Great flavor. After 30+ years of going to a different market, we will now be going here for our kielbasa...
                    </blockquote>
                </article>
                <article class="review-slide" aria-hidden="true">
                    <p class="review-source">Review by - Yelp</p>
                    <p class="review-author">
                        Bryce Z: <span aria-label="5 out of 5 stars">★★★★★</span>
                    </p>
                    <blockquote>
                        Great family run business with exceptional Polish sausage and various other meats. Great smell when you walk in and great service. Has that great neighborhood feel!
                    </blockquote>
                </article>
                <article class="review-slide" aria-hidden="true">
                    <p class="review-source">Review by - Yelp</p>
                    <p class="review-author">
                        Unknown U: <span aria-label="5 out of 5 stars">★★★★★</span>
                    </p>
                    <blockquote>
                        Hidden gem in Grand Rapids. They have wonderful selection of sausage and it tasted amazing. Great place for Polish sausage.
                    </blockquote>
                </article>
                <article class="review-slide" aria-hidden="true">
                    <p class="review-source">Review by - Yelp</p>
                    <p class="review-author">
                        Victoria S: <span aria-label="5 out of 5 stars">★★★★★</span>
                    </p>
                    <blockquote>
                        Best sausage links I've ever had. So good, in fact, that I told my husband today that I do not plan on ever buying sausage links from anywhere but here again.
                    </blockquote>
                </article>
            </div>
            <div class="reviews-dots" aria-label="Review slides">
                <button class="is-active" type="button" aria-label="Show review 1"></button>
                <button type="button" aria-label="Show review 2"></button>
                <button type="button" aria-label="Show review 3"></button>
                <button type="button" aria-label="Show review 4"></button>
                <button type="button" aria-label="Show review 5"></button>
            </div>
            <button class="reviews-pause"
                    type="button"
                    data-reviews-pause
                    aria-label="Pause reviews carousel">Ⅱ</button>
        </div>
    </section>
    <section class="home-map-section" aria-label="Lewandoski's Market location">
        <div id="market-map" class="home-map" data-market-map></div>
    </section>
