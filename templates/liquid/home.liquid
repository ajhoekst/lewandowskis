<section class="hero"
         style="background-image:url('/assets/img/video_poster.jpg')">
    <div class="shell py-24 text-center">
        <h1 class="hero-title mx-auto">Polish heritage, right here on the West Side.</h1>
        <p class="hero-script">Fresh cuts. Homemade sausage. Food worth gathering around.</p>
        <div class="mt-9 flex flex-wrap justify-center gap-4">
            <a class="button-light" href="/products-specialties-gifts">Our Products</a><a class="button-light" href="/contact-us">Visit Us</a>
        </div>
    </div>
</section>
<section class="feature-split bg-market-red text-market-cream">
    <div class="feature-copy">
        <h2 class="section-title text-market-cream">It's steak time</h2>
        <p class="mt-4 section-subtitle text-market-cream">Get ready for grilling season!</p>
        <p class="mt-5 max-w-md text-lg leading-8">
            We have a variety of fresh-cut Choice steaks to make your summer meal memorable.
        </p>
        <a class="button-light mt-7" href="/products-specialties-gifts">Our Products</a>
    </div>
    <div class="feature-image"
         style="background-image:url('/assets/img/b0d219a62bcf41408998cd450a13f378.jpeg')"></div>
</section>
<section class="paper-section">
    <div class="shell max-w-3xl py-3 text-center">
        <img class="mx-auto h-38 w-auto"
             src="/assets/img/logo_2.png"
             alt="Lewandoski's Market">
        <p class="mt-6 text-xl font-bold">100 Years of Polish, Right Here on the West Side</p>
        <p class="mx-auto mt-5 max-w-2xl leading-8">
            Our market has been a fixture on Grand Rapids' West Side since 1923. Come in for high-quality products, incomparable recipes, and food made for the people we call neighbors.
        </p>
    </div>
</section>
<section class="feature-split bg-market-cream">
    <div class="feature-image order-last sm:order-first"
         style="background-image:url('/assets/img/c40d684b2c5b44d6b968115ed95ee4aa.jpeg')"></div>
    <div class="feature-copy">
        <h2 class="section-title">Hot food to go</h2>
        <p class="mt-4 section-subtitle">Wednesdays & Fridays</p>
        <p class="mt-5 text-lg leading-8">
            Every Wednesday and Friday, 11 AM to 2 PM. Find weekly menu information on Facebook or call (616) 454-2281.
        </p>
        <a class="button mt-7"
           href="https://www.facebook.com/162729067084313"
           target="_blank"
           rel="noreferrer">Weekly Menu</a>
    </div>
</section>
<section class="paper-section">
    <div class="shell">
        <h2 class="section-title text-center">Gallery</h2>
        <div class="gallery-grid mt-10">
            {% for item in gallery %}
                <a class="gallery-item group{% if item.wide %} gallery-item--wide{% endif %}"
                   href="{{ item.image }}">
                    <img src="{{ item.image }}" alt="{{ item.title }}">
                    <span>{{ item.title }}</span></a>
            {% endfor %}
        </div>
    </div>
</section>
