<section class="home-carousel" aria-label="Featured market images">
    <div class="home-carousel__slide is-active">
        <video class="home-carousel__media"
               autoplay
               muted
               playsinline
               poster="/assets/img/video_poster.jpg">
            <source src="/assets/video/Lewandoskis_Market_Video_Vimeo_720p30.mp4"
                    type="video/mp4">
        </video>
    </div>
    <div class="home-carousel__slide" aria-hidden="true">
        <img class="home-carousel__media"
             src="/assets/img/gallery/311b147de93440249c03086a5d8d0494.jpeg"
             alt="Charcuterie board with cheeses and cured meats">
    </div>
    <div class="home-carousel__controls">
        <button class="home-carousel__control"
                type="button"
                data-carousel-pause
                aria-label="Pause carousel">
            <svg data-carousel-icon="pause" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 3h5v18H5zm9 0h5v18h-5z" />
            </svg>
            <svg data-carousel-icon="play"
                 viewBox="0 0 24 24"
                 aria-hidden="true"
                 hidden>
                <path d="m7 3 14 9-14 9z" />
            </svg>
        </button>
        <button class="home-carousel__control"
                type="button"
                data-carousel-mute
                aria-label="Unmute video">
            <svg data-carousel-icon="muted" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 9v6h4l5 4V5L7 9z" />
                <path d="m16 9 5 5m0-5-5 5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
            </svg>
            <svg data-carousel-icon="unmuted"
                 viewBox="0 0 24 24"
                 aria-hidden="true"
                 hidden>
                <path d="M3 9v6h4l5 4V5L7 9z" />
                <path d="M16 9a4 4 0 0 1 0 6m2.5-8.5a7 7 0 0 1 0 11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
            </svg>
        </button>
    </div>
</section>
