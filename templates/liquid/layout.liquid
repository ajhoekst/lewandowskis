<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <title>{{ title }} | Lewandoski's Market</title>
        <link rel="stylesheet" href="/static/css/site.css">
        <script src="/static/vendor/htmx-4.0.0.js"></script>
        <script type="module" src="/static/js/lqip-image.js"></script>
        <script type="module" src="/static/js/accessibility.js"></script>
    </head>
    <body>
        <a class="skip-link" href="#content">Skip to main content</a>
        <header class="site-header">
            <div class="site-logo-row">
                <div class="shell relative">
                    <a class="site-logo-link" href="/">
                        <picture>
                            <source type="image/avif"
                                    srcset="/assets/img/logo_2-192.avif 192w,
                                            /assets/img/logo_2-240.avif 240w,
                                            /assets/img/logo_2-480.avif 480w">
                            <source type="image/webp"
                                    srcset="/assets/img/logo_2-192.webp 192w,
                                            /assets/img/logo_2-240.webp 240w,
                                            /assets/img/logo_2-480.webp 480w">
                            <img class="site-logo"
                                 src="/assets/img/logo_2.png"
                                 srcset="/assets/img/logo_2-192.webp 192w,
                                         /assets/img/logo_2-240.webp 240w,
                                         /assets/img/logo_2-480.webp 480w"
                                 sizes="(min-width: 1024px) 240px,
                                        192px"
                                 alt="Lewandoski's Market">
                        </picture>
                    </a>
                </div>
            </div>
            <nav class="site-nav" aria-label="Primary navigation">
                <a href="/about"
                   {% if currentPath == "/about" %}aria-current="page"{% endif %}>About Us</a><a href="/products-specialties-gifts"
   {% if currentPath == "/products-specialties-gifts" %}aria-current="page"{% endif %}>Products, Specialties, &amp; Gifts</a><a href="/events"
   {% if currentPath == "/events" %}aria-current="page"{% endif %}>Events</a><a href="/community-partners"
   {% if currentPath == "/community-partners" %}aria-current="page"{% endif %}>Community Partners</a><a href="/donation-request"
   {% if currentPath == "/donation-request" %}aria-current="page"{% endif %}>Donation Request</a><a href="/contact-us"
   {% if currentPath == "/contact-us" %}aria-current="page"{% endif %}>Contact Us</a><a href="https://www.facebook.com/162729067084313"
   target="_blank"
   rel="noreferrer">Facebook</a><a href="https://www.instagram.com/lewandoskismarket"
   target="_blank"
   rel="noreferrer">Instagram</a>
            </nav>
            <details class="site-mobile-nav">
                <summary aria-label="Open navigation menu">
                    <span></span><span></span><span></span><b class="mobile-menu-label" aria-hidden="true">Menu</b><span class="sr-only">Open navigation menu</span>
                </summary>
                <div class="mobile-nav-list">
                    <div>
                        <a href="/about"
                           {% if currentPath == "/about" %}aria-current="page"{% endif %}>About Us</a><a href="/products-specialties-gifts"
   {% if currentPath == "/products-specialties-gifts" %}aria-current="page"{% endif %}>Products, Specialties, &amp; Gifts</a><a href="/events"
   {% if currentPath == "/events" %}aria-current="page"{% endif %}>Events</a><a href="/community-partners"
   {% if currentPath == "/community-partners" %}aria-current="page"{% endif %}>Community Partners</a><a href="/donation-request"
   {% if currentPath == "/donation-request" %}aria-current="page"{% endif %}>Donation Request</a><a href="/contact-us"
   {% if currentPath == "/contact-us" %}aria-current="page"{% endif %}>Contact Us</a><a href="https://www.facebook.com/162729067084313"
   target="_blank"
   rel="noreferrer">Facebook</a><a href="https://www.instagram.com/lewandoskismarket"
   target="_blank"
   rel="noreferrer">Instagram</a>
                    </div>
                </div>
            </details>
        </header>
        <main id="content">
            {{ content }}
        </main>
        <footer class="site-footer">
            <div class="shell grid gap-8 text-center sm:grid-cols-3 sm:text-left">
                <section>
                    <h2 class="font-display text-2xl uppercase">Lewandoski's Market</h2>
                    <p class="mt-3 leading-7 text-market-cream/85">
                        100 years of Polish tradition, right here on Grand Rapids' West Side.
                    </p>
                </section>
                <section>
                    <h2 class="font-display text-2xl uppercase">Location</h2>
                    <address class="mt-3 not-italic leading-7 text-market-cream/85">1107 Walker Ave NW
                        <br>
                        Grand Rapids, MI 49504
                        <br>
                        <a href="tel:+16164542281">(616) 454-2281</a></address>
                </section>
                <section>
                    <h2 class="font-display text-2xl uppercase">Hours</h2>
                    <p class="mt-3 leading-7 text-market-cream/85">
                        Monday–Friday: 9 AM–5:30 PM
                        <br>
                        Saturday: 9 AM–5:30 PM
                        <br>
                        Sunday: Closed
                    </p>
                </section>
            </div>
        </footer>
    </body>
</html>
