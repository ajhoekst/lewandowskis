<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width,initial-scale=1">
        <title>{{ metadata.title }}</title>
        <meta name="description" content="{{ metadata.description }}">
        <link rel="canonical" href="{{ canonicalUrl }}">
        {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Lewandoski's Market">
        <meta property="og:title" content="{{ metadata.title }}">
        <meta property="og:description" content="{{ metadata.description }}">
        <meta property="og:url" content="{{ canonicalUrl }}">
        <meta property="og:image"
              content="https://lewandowskismarket.com{{ metadata.image }}">
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ metadata.title }}">
        <meta name="twitter:description" content="{{ metadata.description }}">
        <link rel="icon"
              href="/assets/favicons/favicon-32x32.png"
              sizes="32x32"
              type="image/png">
        <link rel="manifest" href="/assets/favicons/site.webmanifest">
        <script type="application/ld+json">{"@context":"https://schema.org","@type":"GroceryStore","name":"Lewandoski's Market","url":"https://lewandowskismarket.com","image":"https://lewandowskismarket.com/assets/img/logo_2.png","telephone":"+1-616-454-2281","address":{"@type":"PostalAddress","streetAddress":"1107 Walker Ave NW","addressLocality":"Grand Rapids","addressRegion":"MI","postalCode":"49504","addressCountry":"US"},"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":"Monday","opens":"09:00","closes":"17:30"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Tuesday","opens":"09:00","closes":"17:30"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Wednesday","opens":"09:00","closes":"17:30"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Thursday","opens":"09:00","closes":"17:30"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Friday","opens":"09:00","closes":"17:30"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Saturday","opens":"09:00","closes":"17:30"}],"specialOpeningHoursSpecification":[{"@type":"OpeningHoursSpecification","validFrom":"2026-07-04","validThrough":"2026-07-04","opens":"00:00","closes":"00:00"},{"@type":"OpeningHoursSpecification","validFrom":"2026-12-24","validThrough":"2026-12-24","opens":"08:00","closes":"12:00"},{"@type":"OpeningHoursSpecification","validFrom":"2026-12-25","validThrough":"2026-12-26","opens":"00:00","closes":"00:00"}],"sameAs":["https://www.facebook.com/162729067084313","https://www.instagram.com/lewandoskismarket"]}</script>
        {% if currentPath == "/" %}
            <script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Do you make fresh kielbasa and sausage?","acceptedAnswer":{"@type":"Answer","text":"Lewandoski's Market offers fresh and smoked kielbasa, Krakowska, and a selection of house-made sausage. Visit the market to see today's selection."}},{"@type":"Question","name":"Where is Lewandoski's Market located?","acceptedAnswer":{"@type":"Answer","text":"Lewandoski's Market is located at 1107 Walker Ave NW in Grand Rapids, Michigan."}},{"@type":"Question","name":"What are your market hours?","acceptedAnswer":{"@type":"Answer","text":"Lewandoski's Market is open Monday through Saturday from 9 AM to 5:30 PM and is closed on Sundays."}},{"@type":"Question","name":"Do you carry Polish grocery products?","acceptedAnswer":{"@type":"Answer","text":"The market carries Polish grocery staples, pierogi, specialty ingredients, and pantry favorites."}},{"@type":"Question","name":"How do donation requests work?","acceptedAnswer":{"@type":"Answer","text":"Submit donation requests at least four weeks before your event through the donation request form."}}]}</script>
        {% endif %}
        <link rel="stylesheet" href="/static/css/site.css">
        <script src="/static/vendor/htmx-4.0.0.js"></script>
        <script type="module" src="/static/js/lqip-image.js"></script>
        <script type="module" src="/static/js/accessibility.js"></script>
    </head>
    <body>
        <a class="skip-link" href="#content">Skip to main content</a>
        <header class="site-header{% if currentPath == "/" %} site-header--home{% endif %}">
            <div class="site-logo-row">
                <div class="shell relative">
                    <a class="site-logo-link" href="/">
                        <picture>
                            <source type="image/avif"
                                    srcset="/assets/img/logo_2-192.avif 192w,
                                            /assets/img/logo_2-240.avif 240w,
                                            /assets/img/logo_2-480.avif 480w">
                            <source type="image/webp"
                                    srcset="/assets/img/logo_2-192.webp 192w,
                                            /assets/img/logo_2-240.webp 240w,
                                            /assets/img/logo_2-480.webp 480w">
                            <img class="site-logo"
                                 src="/assets/img/logo_2.png"
                                 srcset="/assets/img/logo_2-192.webp 192w,
                                         /assets/img/logo_2-240.webp 240w,
                                         /assets/img/logo_2-480.webp 480w"
                                 sizes="(min-width: 1024px) 240px,
                                        192px"
                                 alt="Lewandoski's Market">
                        </picture>
                    </a>
                </div>
            </div>
            <nav class="site-nav" aria-label="Primary navigation">
                <a href="/about"
                   {% if currentPath == "/about" %}aria-current="page"{% endif %}>About Us</a><a href="/products-specialties-gifts"
   {% if currentPath == "/products-specialties-gifts" %}aria-current="page"{% endif %}>Products, Specialties, &amp; Gifts</a><a href="/events"
   {% if currentPath == "/events" %}aria-current="page"{% endif %}>Events</a><a href="/community-partners"
   {% if currentPath == "/community-partners" %}aria-current="page"{% endif %}>Community Partners</a><a href="/donation-request"
   {% if currentPath == "/donation-request" %}aria-current="page"{% endif %}>Donation Request</a><a href="/contact-us"
   {% if currentPath == "/contact-us" %}aria-current="page"{% endif %}>Contact Us</a><a href="https://www.facebook.com/162729067084313"
   target="_blank"
   rel="noreferrer">Facebook</a><a href="https://www.instagram.com/lewandoskismarket"
   target="_blank"
   rel="noreferrer">Instagram</a>
            </nav>
            <nav class="site-mobile-social" aria-label="Social media">
                <a href="https://www.facebook.com/162729067084313"
                   target="_blank"
                   rel="noreferrer"
                   aria-label="Facebook">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14 8h3V4h-3c-3 0-5 2-5 5v3H6v4h3v8h4v-8h3l1-4h-4V9c0-.6.4-1 1-1Z" fill="currentColor" />
                    </svg>
                </a><a href="https://www.instagram.com/lewandoskismarket"
   target="_blank"
   rel="noreferrer"
   aria-label="Instagram">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
            </a><a href="https://www.yelp.com/biz/lewandowskis-market-grand-rapids"
   target="_blank"
   rel="noreferrer"
   aria-label="Yelp">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m12 2 1.8 6.2L20 5l-3.2 5.6L22 12l-6.2 1.8L19 20l-5.6-3.2L12 22l-1.8-6.2L4 19l3.2-5.6L2 12l6.2-1.8L5 4l5.6 3.2L12 2Z" fill="currentColor" />
            </svg>
        </a>
    </nav>
    <details class="site-mobile-nav">
        <summary aria-label="Open navigation menu">
            <span></span><span></span><span></span><b class="mobile-menu-label" aria-hidden="true">Menu</b><span class="sr-only">Open navigation menu</span>
        </summary>
        <div class="mobile-nav-list">
            <div>
                <a href="/about"
                   {% if currentPath == "/about" %}aria-current="page"{% endif %}>About Us</a><a href="/products-specialties-gifts"
   {% if currentPath == "/products-specialties-gifts" %}aria-current="page"{% endif %}>Products, Specialties, &amp; Gifts</a><a href="/events"
   {% if currentPath == "/events" %}aria-current="page"{% endif %}>Events</a><a href="/community-partners"
   {% if currentPath == "/community-partners" %}aria-current="page"{% endif %}>Community Partners</a><a href="/donation-request"
   {% if currentPath == "/donation-request" %}aria-current="page"{% endif %}>Donation Request</a><a href="/contact-us"
   {% if currentPath == "/contact-us" %}aria-current="page"{% endif %}>Contact Us</a><a href="https://www.facebook.com/162729067084313"
   target="_blank"
   rel="noreferrer">Facebook</a><a href="https://www.instagram.com/lewandoskismarket"
   target="_blank"
   rel="noreferrer">Instagram</a>
            </div>
        </div>
    </details>
</header>
<main id="content">
    {{ content }}
</main>
<footer class="site-footer">
    <div class="shell grid gap-8 text-center sm:grid-cols-3 sm:text-left">
        <section>
            <h2 class="font-display text-2xl uppercase">Lewandoski's Market</h2>
            <p class="mt-3 leading-7 text-market-cream/85">
                100 years of Polish tradition, right here on Grand Rapids' West Side.
            </p>
        </section>
        <section>
            <h2 class="font-display text-2xl uppercase">Location</h2>
            <address class="mt-3 not-italic leading-7 text-market-cream/85">1107 Walker Ave NW
                <br>
                Grand Rapids, MI 49504
                <br>
                <a href="tel:+16164542281">(616) 454-2281</a>
                <br>
                <a href="https://www.google.com/maps/dir/?api=1&amp;destination=1107+Walker+Ave+NW,+Grand+Rapids,+MI+49504"
                   target="_blank"
                   rel="noreferrer">Get directions</a></address>
        </section>
        <section>
            <h2 class="font-display text-2xl uppercase">Hours</h2>
            <p class="mt-3 leading-7 text-market-cream/85">
                Monday–Friday: 9 AM–5:30 PM
                <br>
                Saturday: 9 AM–5:30 PM
                <br>
                Sunday: Closed
            </p>
            <p class="mt-4 leading-7 text-market-cream/85">
                <strong>2026 Holiday Hours</strong>
                <br>
                July 4: Closed
                <br>
                December 24: 8 AM–12 PM
                <br>
                December 25–26: Closed
            </p>
            <p class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
                <a href="https://www.facebook.com/162729067084313"
                   target="_blank"
                   rel="noreferrer">Facebook</a><a href="https://www.instagram.com/lewandoskismarket"
   target="_blank"
   rel="noreferrer">Instagram</a><a href="https://www.yelp.com/biz/lewandoskis-market-grand-rapids"
   target="_blank"
   rel="noreferrer">Yelp</a>
            </p>
        </section>
    </div>
</footer>
</body>
</html>
