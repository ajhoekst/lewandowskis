<nav id="menu-category-nav"
     hx-swap-oob="outerHTML"
     class="product-category-nav"
     aria-label="Menu categories">
    {% for category in menu %}
        <a class="button-menu{% if category.slug == selected.slug %} !bg-market-cream !text-market-ink{% endif %}"
           href="/products/{{ category.slug }}"
           hx-get="/products/{{ category.slug }}"
           hx-target="#menu-category"
           hx-swap="outerHTML"
           hx-push-url="true"
           data-category="{{ category.slug }}"
           {% if category.slug == selected.slug %}aria-current="page"{% endif %}>{{ category.name }}</a>
    {% endfor %}
</nav>
<section id="menu-category"
         tabindex="-1"
         aria-live="polite"
         data-selected-category="{{ selected.slug }}"
         class="product-category">
    <h1 class="section-title">{{ selected.name }}</h1>
    <p class="product-category__intro">{{ selected.description }}</p>
    <p class="product-category__copy">{{ selected.copy }}</p>
    <div class="product-category__items">
        {% for item in selected.images %}
            <article class="product-item">
                {% assign base = item.src | remove: ".jpeg" %}
                <lqip-image>
                <img class="lqip__placeholder"
                     src="{{ base }}-32.webp"
                     alt=""
                     aria-hidden="true"
                     role="presentation">
                <picture>
                    <source type="image/avif"
                            srcset="{{ base }}-320.avif 320w,
                                    {{ base }}-480.avif 480w,
                                    {{ base }}-640.avif 640w,
                                    {{ base }}-768.avif 768w,
                                    {{ base }}-1024.avif 1024w">
                    <source type="image/webp"
                            srcset="{{ base }}-320.webp 320w,
                                    {{ base }}-480.webp 480w,
                                    {{ base }}-640.webp 640w,
                                    {{ base }}-768.webp 768w,
                                    {{ base }}-1024.webp 1024w">
                    <img class="lqip__image aspect-[4/3] w-full object-cover"
                         src="{{ item.src }}"
                         srcset="{{ base }}-320.webp 320w,
                                 {{ base }}-480.webp 480w,
                                 {{ base }}-640.webp 640w,
                                 {{ base }}-768.webp 768w,
                                 {{ base }}-1024.webp 1024w"
                         sizes="(min-width: 768px) 40vw,
                                100vw"
                         alt="{{ item.alt }}"
                         loading="lazy"
                         decoding="async">
                </picture>
                </lqip-image>
                <h2>{{ item.alt }}</h2>
                <p>{{ item.description }}</p>
            </article>
        {% endfor %}
    </div>
</section>
